# Copy to .env (or export these) before `npm start`. Every value is optional.

# Claude answers. Without a key the app uses the offline extractive answerer.
ANTHROPIC_API_KEY=
# Model for the answer step.
ANSWER_MODEL=claude-haiku-5-5
# Set to "extractive" to force the offline answerer even when a key is set.
ANSWER_ENGINE=

# Where PGlite keeps the database.
RAG_DATA_DIR=data/db
# HTTP server.
HOST=127.0.0.1
PORT=8787
